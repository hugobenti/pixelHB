# Google sign-in and Drive sync. Copy to .env.local; never commit real values.
# Sign-in is shown only when NEXT_PUBLIC_DRIVE_SYNC=on.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_DRIVE_SYNC=
# Leave these two out unless needed: a blank value is read as "" and breaks Auth.js (UntrustedHost).
# AUTH_TRUST_HOST=true
# AUTH_REDIRECT_PROXY_URL=https://pixelhb.vercel.app/api/auth
